  "plan": {
    "summary": "A simple habit tracker. Add daily habits, check them off each day, and see current and best streaks. Data is stored locally on the device.",
    "screens": [
      {
        "name": "Today",
        "purpose": "List of habits with a check toggle for today and current streak badge; empty state"
      },
      {
        "name": "Add/Edit Habit",
        "purpose": "Create or rename a habit"
      },
      {
        "name": "Habit Detail",
        "purpose": "Current streak, best streak, last 5 weeks calendar grid, delete"
      }
    ],
    "decisions": [
      "Provider-free: ValueNotifier/ChangeNotifier state",
      "Local storage via shared_preferences (JSON)",
      "Repository interface with in-memory implementation for tests",
      "Material 3 light and dark themes",
      "Streak = consecutive days ending today (or yesterday if today not yet done)"
    ],
    "approved": true,
